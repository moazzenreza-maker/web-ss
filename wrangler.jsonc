{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ss",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "465c17d4-cc1d-427c-8b94-5154b4ccc4e0","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f9a72e52ff4841e091c74ed03ab20c10" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
